# In-Game Issue Reporting & Crash Ticketing (TK-RPT-100)
# Server-only GitHub credentials — never prefix with NEXT_PUBLIC_.
# When unset in development/test, reports write to logs/reports/ in dry-run mode.
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPO=chadmowery/nirmata-run
GITHUB_ISSUES_ENABLED=false

# Hourly server-side report submission caps (defaults: 40 crashes, 20 manual)
REPORTS_CRASH_CAP_PER_HOUR=40
REPORTS_MANUAL_CAP_PER_HOUR=20

# Optional build SHA exposed in client and server crash diagnostics (default: dev)
NEXT_PUBLIC_BUILD_SHA=dev
